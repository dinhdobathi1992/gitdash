# ── Mode ──────────────────────────────────────────────────────────────────────
# Controls how GitDash authenticates users.
#
#   standalone   → No OAuth. Each user enters their own GitHub PAT on /setup.
#                  PAT is stored in an encrypted session cookie.
#                  Default when MODE is unset.
#
#   organization → GitHub OAuth. Users sign in via GitHub. Requires CLIENT_ID
#                  and CLIENT_SECRET below.
#                  Aliases accepted: org, team
#
# MODE=standalone

# ── OAuth credentials (organization mode only) ────────────────────────────────
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL:  http://localhost:3000
# Callback URL:  http://localhost:3000/api/auth/callback
# GITHUB_CLIENT_ID=your_client_id_here
# GITHUB_CLIENT_SECRET=your_client_secret_here
#
# Organization mode access control (see README "Organization Mode Access Control").
# Requires DATABASE_URL. Numeric GitHub user ids (gh api user --jq .id):
# GITDASH_ADMIN_GITHUB_IDS=12345678
# Optional — only active members of these orgs may sign in:
# GITDASH_ALLOWED_ORGS=my-org
# Rollout switch — false keeps today's access while admins assign groups:
# GITDASH_RBAC_ENFORCE=false

# ── Product landing page (optional) ───────────────────────────────────────────
# true → signed-out visitors opening "/" see the /welcome product page instead
# of the sign-in screen; its Sign in button goes to /login. Meant for the public
# gitdash.info site — leave unset on a self-hosted instance.
# GITDASH_LANDING_PAGE=false

# ── Signed-in MCP for AI apps (optional, off by default) ──────────────────────
# true → AI apps such as Claude or Cursor can sign in at /mcp/me and read GitDash
# data as the signed-in user, read-only. Needs MODE=organization, DATABASE_URL and
# NEXT_PUBLIC_APP_URL, plus a second callback URL on the GitHub OAuth App:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/mcp
# GITDASH_MCP=false
# true → also accept Dynamic Client Registration (default off):
# MCP_ALLOW_DCR=false
# Custom redirect schemes allowed for desktop apps, comma-separated (default none):
# MCP_NATIVE_SCHEMES=cursor
# After rotating SESSION_SECRET, keep the old value here for 30 days so connected
# apps keep working, then remove it:
# MCP_PREVIOUS_SESSION_SECRET=

# ── Session encryption ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_32_char_string_here

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Historical database (optional) ────────────────────────────────────────────
# Neon / PostgreSQL connection string. Enables /api/db/* sync, trends, reports,
# and alert-rule storage. Leave unset for live-only GitHub analytics.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Local development without Neon: run a local Postgres + Neon HTTP proxy with
#   docker compose -f docker-compose.local-db.yml up -d
# then point the (unchanged) Neon driver at it. Only localhost / 127.0.0.1
# endpoints are accepted (the driver sends the DB password to this endpoint).
# DATABASE_URL=postgres://postgres:postgres@localhost:55432/gitdash
# NEON_LOCAL_FETCH_ENDPOINT=http://localhost:4444/sql
#
# With DATABASE_URL set, GitHub API responses are also cached in the
# `api_cache` table so replicas share them (see README-SECURITY-ENHANCEMENTS.md).
# Set to 0 to keep caching in-process only.
# GITDASH_L2_CACHE=1

# ── GitHub rate-limit telemetry (optional) ───────────────────────────────────
# 1 = log one line per GitHub API call (route, path, status, remaining budget).
# A warning when a token's budget drops below 10% is always logged.
# GITDASH_GH_LOG=1

# ── Webhook ingest (optional) ─────────────────────────────────────────────────
# Secret for verifying the HMAC signature on /api/webhooks/github. If unset,
# the webhook endpoint rejects all requests (fail-safe).
# GITHUB_WEBHOOK_SECRET=replace_with_webhook_secret

# ── Fallback token (optional) ─────────────────────────────────────────────────
# Server-side GitHub token used when no session token is available. Required
# for the scheduled sync cron (/api/cron/sync), which has no user session.
# GITHUB_TOKEN=ghp_...

# ── Scheduled sync cron (optional) ────────────────────────────────────────────
# Authorizes /api/cron/sync (see vercel.json). Vercel Cron sends this
# automatically as "Authorization: Bearer $CRON_SECRET" when the env var is
# set on the project. The route fails closed (401) if unset.
# CRON_SECRET=replace_with_a_random_secret

# ── Demo mode (optional) ──────────────────────────────────────────────────────
# Serve sanitized demo data with no token. Can also be enabled per-request
# with ?demo=1 in the URL.
# NEXT_PUBLIC_DEMO_MODE=true

# ── Alert email delivery (optional) ───────────────────────────────────────────
# Resend is preferred when RESEND_API_KEY is set.
# RESEND_API_KEY=re_...
# RESEND_FROM=alerts@yourdomain.com
#
# SendGrid alternative (used when RESEND_API_KEY is not set).
#
# NOTE: despite the name, this path does NOT speak the SMTP protocol -- it POSTs
# to SendGrid's HTTP API at ${SMTP_HOST}/v3/mail/send. SMTP_HOST must therefore
# be a full HTTPS base URL, not a mail hostname: smtp.gmail.com will NOT work.
# SMTP_PORT is not read at all. For a real SMTP relay, none of this applies.
#
# Prefer configuring email in Settings -- Email Delivery instead (v4.1.3+).
# SMTP_HOST=https://api.sendgrid.com
# SMTP_PASS=SG.your_api_key
# SMTP_FROM=alerts@yourdomain.com

# ── AI features (optional) ────────────────────────────────────────────────────
# When no key is set, every AI surface is hidden and GitDash behaves exactly as
# it did before v4.1.0. Providers are tried in the order below; any without a
# key is skipped, so configuring just one is fine.
#
# 1. Bailian (Alibaba Cloud) — speaks the Anthropic Messages API, not the
#    OpenAI shape. Extended thinking is disabled automatically: Qwen models
#    enable it by default and it costs ~10x the output tokens for no benefit
#    on structured extraction.
#    Models: qwen3.6-flash (default), qwen3.6-plus, qwen3.7-plus,
#            qwen3.7-max, qwen3.8-max
# BAILIAN_API_KEY=sk-sp-...
# BAILIAN_MODEL=qwen3.6-flash
# BAILIAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1
#
# 2. Google Gemini — OpenAI-compatible endpoint.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
#
# 3. Qwen via DashScope — OpenAI-compatible endpoint (distinct from Bailian).
# QWEN_API_KEY=...
# QWEN_MODEL=qwen-plus
#
# Safety valves:
# AI_DISABLED=true              # hard-kill the layer regardless of keys
# AI_TIMEOUT_MS=15000           # per provider attempt
# AI_TOTAL_BUDGET_MS=45000      # across all attempts within one request
# AI_DAILY_TOKEN_BUDGET=2000000 # per instance per UTC day; 0 = unlimited.
#                               # In-process counter: a damage-limiter, not a
#                               # hard global cap on a multi-instance deploy.
